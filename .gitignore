# dependencies
node_modules/
.pnp.*
.yarn/*

# build output
dist/
build/
*.tsbuildinfo
coverage/

# expo / react native
.expo/
.expo-shared/
android/
# The store listing F-Droid reads is kept; only the generated native project is not.
!apps/mobile/fastlane/metadata/android/
ios/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
web-build/

# secrets & local config
.env
.env.*
# The server's own settings for docker compose: secrets live here (see below for copies).
!.env.example
*.pem

# editors / os
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# test / debug artifacts
sim-failures/
*.log
npm-debug.*
yarn-debug.*
yarn-error.*

# local server data
.sheaf-data/
# Copies of a database or a backup hold document text and password hashes, and a
# copy of server.env holds every key. The one test fixture database is kept.
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
!services/ingest/test/fixtures/*.db
server.env*
backups/

# Python build output
__pycache__/
*.pyc

# Notes kept beside the code but not published with it
review/
docs/research/

# Downloaded research data and recorded model replies. The eval's fetch script and
# golden sample are committed; the raw dataset and the live-response cache are not,
# so the repo carries no third-party documents and no recorded API traffic.
packages/extract/eval/cache/
