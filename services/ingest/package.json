{
  "name": "@sheaf/ingest",
  "version": "0.0.0",
  "private": true,
  "description": "The Sheaf ingestion server. Content-addressed, idempotent, no runtime dependencies.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "start": "node --experimental-strip-types src/main.ts",
    "export": "node --experimental-strip-types src/backup-cli.ts export",
    "import": "node --experimental-strip-types src/backup-cli.ts import"
  },
  "dependencies": {
    "@sheaf/core": "workspace:*",
    "@sheaf/extract": "workspace:*",
    "@sheaf/http": "workspace:*",
    "@sheaf/paperless": "workspace:*",
    "@sheaf/protocol": "workspace:*",
    "@sheaf/store": "workspace:*",
    "@zxing/library": "0.21.3",
    "jpeg-js": "0.4.4",
    "pdf-lib": "1.17.1"
  },
  "devDependencies": {
    "@sheaf/sim": "workspace:*"
  }
}
