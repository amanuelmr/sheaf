{
  "name": "@sheaf/ingest",
  "version": "0.0.0",
  "private": true,
  "description": "The Sheaf ingestion server. Content-addressed, idempotent, no runtime dependencies.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "start": "node --experimental-strip-types src/main.ts"
  },
  "dependencies": {
    "@sheaf/core": "workspace:*",
    "@sheaf/http": "workspace:*",
    "@sheaf/paperless": "workspace:*",
    "@sheaf/protocol": "workspace:*",
    "@sheaf/store": "workspace:*"
  },
  "devDependencies": {
    "@sheaf/sim": "workspace:*"
  }
}
