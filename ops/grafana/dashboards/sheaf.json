        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sheaf_extraction_latency_ms_avg",
          "legendFormat": "{{provider}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
